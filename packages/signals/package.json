    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/dsh-triage.git",
    "directory": "packages/signals"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@dsh-triage/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b"
  }
