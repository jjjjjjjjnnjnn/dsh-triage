    "id": "CASE-11012",
    "title": "MCP tools silently disappear after in-app upgrade: transitive plugin stuck on the previous rc with exact peers",
    "source": {
      "kind": "github-discussion",
      "url": "https://github.com/deepseek-ai/deepseek-harness/discussions/11012",
      "author": "lybym",
