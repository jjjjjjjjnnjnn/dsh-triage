# --- Node / pnpm ---
node_modules/
*.tsbuildinfo
**/dist/
packages/*/lib/
.pnpm-store/

# --- local runtime scratch (never committed) ---
.env
.env.*
!/.env.example
*.log
coverage/
.tmp/
probe-work/
local/
.local/
# gh CLI writes its own state here; it is per-machine, never a commit.
# R71: the CI watcher's rolling state (cache-only, never a commit). Present so a local run does not
# accidentally stage it; the same directory name is what `.github/workflows/watch-upstream.yml` caches.
.watch-state/
# Repo-internal DSH sandbox (upstream runtime + profile deps for live testing).
sandbox/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
